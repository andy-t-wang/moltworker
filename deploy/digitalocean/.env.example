# Copy to deploy/digitalocean/.env and fill values.
# Do NOT commit your .env.

# Network
OPENCLAW_PUBLIC_BIND=0.0.0.0
OPENCLAW_PUBLIC_PORT=18789
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BIND=0.0.0.0
OPENCLAW_VERBOSE=true

# Persistent host paths
OPENCLAW_CONFIG_PATH=/opt/openclaw/config
OPENCLAW_WORKSPACE_PATH=/opt/openclaw/workspace

# Required: pick one provider/auth path
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Cloudflare AI Gateway
CLOUDFLARE_AI_GATEWAY_API_KEY=
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_GATEWAY_ID=
CF_AI_GATEWAY_MODEL=

# Required for remote access hardening
OPENCLAW_GATEWAY_TOKEN=

# Optional chat channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_DM_POLICY=pairing
TELEGRAM_DM_ALLOW_FROM=
DISCORD_BOT_TOKEN=
DISCORD_DM_POLICY=pairing
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
